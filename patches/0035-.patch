index 2e01dba..0ba3790 100644
--- a/src/services/playback/audioContextRecovery.ts
+++ b/src/services/playback/audioContextRecovery.ts
@@ -12,10 +12,42 @@
 // - 状态自己掉出 running（播放中被路由切换、被来电打断）时补一次迟到的重试，免得必须再点一下。
 //
 // 都尽量安静：running 时只是一次属性读取就返回，不改状态、不打日志、不排队。
+//
+// 第二件事（2026-10，0.6.8）：context 的构造参数。用户实测的分界很干净 ——
+// 「先外放播、再连蓝牙」能放（context 早就在扬声器上跑起来了，蓝牙只是把已有的输出流改路由），
+// 「一直连着蓝牙、直接按播放」不能放（context 是在蓝牙的那个 sink 上现开的）。
+// 安卓上这一档取样率由输出设备决定，A2DP 只给 48k，而 Chromium 的 WebView 默认按 44.1k 开——
+// 开到蓝牙 sink 上就拿不到输出流：context 停在非 running，节点图不推进，静音但元素照走。
+// 因此安卓壳上显式开 48k + 'playback' 延迟档（大缓冲对蓝牙也更稳）；构造失败仍退回默认参数。
+// 桌面 Electron 不动：44.1k 素材不引入重采样。
 
 /** 只有 running 才是「音频真的在走」。'suspended' / 'interrupted'（安卓）/ 'closed' 都要重新拉。 */
 export const needsAudioResume = (state: AudioContextState | string): boolean => state !== 'running';
 
+/**
+ * context 的构造参数。纯函数，只看 UA：安卓（WebView 壳）要显式定档，其它平台返回 null 表示「按默认建」。
+ */
+export const buildAudioContextOptions = (userAgent: string | undefined): AudioContextOptions | null => {
+    if (!userAgent || !/Android/i.test(userAgent)) return null;
+    return { latencyHint: 'playback', sampleRate: 48000 };
+};
+
+/**
+ * 按上面的参数建 context；构造被拒（老 WebView 不认这两个字段）就退回无参构造，不让它变成「播不了」。
+ */
+export const createPlaybackAudioContext = (AudioContextClass: typeof AudioContext): AudioContext => {
+    const userAgent = typeof navigator === 'undefined' ? undefined : navigator.userAgent;
+    const options = buildAudioContextOptions(userAgent);
+    if (options) {
+        try {
+            return new AudioContextClass(options);
+        } catch {
+            // 落到下面按默认建。
+        }
+    }
+    return new AudioContextClass();
+};
+
 /** 掉出 running 之后多久补一次重试：给系统把路由切完的时间。只补一次，不和平台抢。 */
 const STATE_RETRY_DELAY_MS = 400;
 
