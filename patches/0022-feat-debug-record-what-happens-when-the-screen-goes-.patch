+import type { Incident } from './incidents';
+
+// src/services/debug/incidentOverlay.ts
+// The only thing that can still appear after React is gone.
+//
+// If the root tree unmounts (an exception in render or in an effect, and nothing catches it), every
+// component including an error boundary is off the page, and `body` is #09090b - the screen is black
+// with the WebView perfectly alive. A React-rendered message cannot exist in that state, so this is
+// plain DOM appended to the document, styled inline: no Tailwind class, no portal, no store.
+//
+// Deliberately NOT shown for ordinary errors. A thrown click handler leaves a working app, and
+// covering the player with a red box for it would be worse than the exception. It is reserved for
+// "there is nothing on the screen", which is the state it can also fix.
+
+const OVERLAY_ID = 'folia-incident-overlay';
+
+const formatTime = (at: number): string => {
+    const date = new Date(at);
+    const pad = (value: number) => String(value).padStart(2, '0');
+    return `${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
+};
+
+const KIND_LABEL: Record<Incident['kind'], string> = {
+    error: '未捕获异常',
+    rejection: '未处理的 Promise 拒绝',
+    'gl-lost': 'WebGL 上下文丢失',
+    'gl-restored': 'WebGL 上下文恢复',
+    'blank-root': 'React 根节点空了',
+};
+
+export type IncidentOverlayOptions = {
+    title: string;
+    incidents: readonly Incident[];
+};
+
+/** Shows (or replaces) the overlay. The reload button is the whole point of it existing. */
+export const showIncidentOverlay = ({ title, incidents }: IncidentOverlayOptions): void => {
+    if (typeof document === 'undefined') {
+        return;
+    }
+    document.getElementById(OVERLAY_ID)?.remove();
+
+    const host = document.createElement('div');
+    host.id = OVERLAY_ID;
+    host.setAttribute('role', 'alertdialog');
+    host.style.cssText = [
+        'position:fixed', 'inset:0', 'z-index:2147483600',
+        'display:flex', 'flex-direction:column', 'gap:12px',
+        'padding:20px', 'box-sizing:border-box',
+        'background:rgba(9,9,11,0.96)', 'color:#e4e4e7',
+        'font:500 13px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace',
+        'overflow:auto',
+    ].join(';');
+
+    const heading = document.createElement('div');
+    heading.textContent = title;
+    heading.style.cssText = 'font-weight:700;font-size:15px;color:#fca5a5;flex:none';
+    host.appendChild(heading);
+
+    const hint = document.createElement('div');
+    hint.textContent = '这条信息会保留到下次重载之后；重新加载一般能回到可用状态。';
+    hint.style.cssText = 'opacity:0.6;flex:none';
+    host.appendChild(hint);
+
+    const list = document.createElement('div');
+    list.style.cssText = 'display:flex;flex-direction:column;gap:6px;flex:1 1 auto;min-height:0';
+    for (const incident of incidents.slice(-6)) {
+        const line = document.createElement('div');
+        line.style.cssText = 'padding:8px 10px;border-radius:8px;background:rgba(148,163,184,0.12);word-break:break-word';
+        const meta = document.createElement('div');
+        meta.textContent = `${formatTime(incident.at)} · ${KIND_LABEL[incident.kind]}`;
+        meta.style.cssText = 'opacity:0.55;font-size:11px';
+        const detail = document.createElement('div');
+        detail.textContent = incident.detail || '(无内容)';
+        line.append(meta, detail);
+        list.appendChild(line);
+    }
+    host.appendChild(list);
+
+    const actions = document.createElement('div');
+    actions.style.cssText = 'display:flex;gap:10px;flex:none';
+
+    const reload = document.createElement('button');
+    reload.type = 'button';
+    reload.textContent = '重新加载';
+    reload.style.cssText = [
+        'flex:1 1 auto', 'padding:10px 14px', 'border-radius:10px', 'cursor:pointer',
+        'border:1px solid rgba(147,197,253,0.5)', 'background:rgba(59,130,246,0.25)',
+        'color:#dbeafe', 'font:inherit', 'font-weight:700',
+    ].join(';');
+    reload.addEventListener('click', () => window.location.reload());
+
+    const dismiss = document.createElement('button');
+    dismiss.type = 'button';
+    dismiss.textContent = '关闭';
+    dismiss.style.cssText = [
+        'flex:0 0 auto', 'padding:10px 14px', 'border-radius:10px', 'cursor:pointer',
+        'border:1px solid rgba(148,163,184,0.35)', 'background:transparent',
+        'color:#cbd5e1', 'font:inherit',
+    ].join(';');
+    dismiss.addEventListener('click', () => host.remove());
+
+    actions.append(reload, dismiss);
+    host.appendChild(actions);
+    document.body.appendChild(host);
+};
+
+export const hideIncidentOverlay = (): void => {
+    if (typeof document === 'undefined') {
+        return;
+    }
+    document.getElementById(OVERLAY_ID)?.remove();
+};
diff --git a/src/services/debug/incidents.ts b/src/services/debug/incidents.ts
new file mode 100644
index 0000000..bfc9bff
--- /dev/null
+++ b/src/services/debug/incidents.ts
@@ -0,0 +1,146 @@
+// src/services/debug/incidents.ts
+// What went wrong, kept somewhere a phone with no adb can still show it.
+//
+// A black screen is the worst possible bug report: `body` is #09090b, so an unmounted React tree
+// and a healthy app whose background layers stopped drawing look identical, and this device has no
+// console to ask (see frameSamples.ts for the same argument). Every path that can blank the screen
+// therefore records a line here, and the frame HUD prints the last one: "it went black again"
+// becomes a screenshot with a message in it.
+//
+// The ring lives in memory AND its tail is persisted, because the interesting case is the one where
+// the page had to be reloaded: the evidence has to outlive the document that produced it.
+
+export type IncidentKind = 'error' | 'rejection' | 'gl-lost' | 'gl-restored' | 'blank-root';
+
+export type Incident = {
+    /** Date.now() when it happened. */
+    at: number;
+    kind: IncidentKind;
+    detail: string;
+};
+
+/** Enough to see a pattern in one session; small enough that a stuck loop cannot grow it. */
+const CAPACITY = 64;
+
+/** Only the tail is persisted: localStorage holds one string and is written synchronously. */
+const PERSISTED = 8;
+
+const STORAGE_KEY = 'folia_incidents';
+
+/** Longest detail kept. An exception message with a stack can be thousands of characters. */
+const DETAIL_MAX = 220;
+
+const isIncidentKind = (value: unknown): value is IncidentKind =>
+    value === 'error' || value === 'rejection' || value === 'gl-lost'
+    || value === 'gl-restored' || value === 'blank-root';
+
+/** Collapses whitespace and clips: an exception message is often several lines of noise. */
+export const clipDetail = (detail: string): string => {
+    const flat = detail.replace(/\s+/g, ' ').trim();
+    return flat.length > DETAIL_MAX ? `${flat.slice(0, DETAIL_MAX - 1)}…` : flat;
+};
+
+/** Tolerant on purpose: a corrupt entry must cost that entry, never the whole log. */
+const readPersisted = (): Incident[] => {
+    if (typeof localStorage === 'undefined') {
+        return [];
+    }
+    try {
+        const raw = localStorage.getItem(STORAGE_KEY);
+        if (!raw) {
+            return [];
+        }
+        const parsed: unknown = JSON.parse(raw);
+        if (!Array.isArray(parsed)) {
+            return [];
+        }
+        return parsed.flatMap(entry => {
+            if (!entry || typeof entry !== 'object') {
+                return [];
+            }
+            const { at, kind, detail } = entry as Record<string, unknown>;
+            if (typeof at !== 'number' || !Number.isFinite(at) || !isIncidentKind(kind)) {
+                return [];
+            }
+            return [{ at, kind, detail: typeof detail === 'string' ? clipDetail(detail) : '' }];
+        }).slice(-PERSISTED);
+    } catch {
+        // Private mode, quota, or a JSON parser error: an empty log beats a module that throws on
+        // import, which would take the whole app down at boot.
+        return [];
+    }
+};
+
+const listeners = new Set<() => void>();
+
+/** Newest last, so the HUD and any overlay can read the tail without sorting. */
+let incidents: Incident[] = readPersisted();
+
+/** Serialisable snapshot for useSyncExternalStore consumers. */
+let snapshot: readonly Incident[] = incidents.slice();
+
+const persist = () => {
+    if (typeof localStorage === 'undefined') {
+        return;
+    }
+    try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(incidents.slice(-PERSISTED)));
+    } catch {
+        // Same reasoning as above, in the other direction: losing the log must not break the app.
+    }
+};
+
+const publish = () => {
+    snapshot = incidents.slice();
+    listeners.forEach(listener => listener());
+};
+
+/** The one way anything gets written. Never throws. */
+export const recordIncident = (kind: IncidentKind, detail: string): Incident => {
+    const incident: Incident = { at: Date.now(), kind, detail: clipDetail(detail) };
+    incidents.push(incident);
+    if (incidents.length > CAPACITY) {
+        incidents = incidents.slice(-CAPACITY);
+    }
+    persist();
+    publish();
+    return incident;
+};
+
+export const readIncidents = (): readonly Incident[] => snapshot;
+
+/** The most recent entry of one kind, or of any kind when `kind` is omitted. */
+export const lastIncident = (kind?: IncidentKind): Incident | null => {
+    for (let index = incidents.length - 1; index >= 0; index -= 1) {
+        const incident = incidents[index];
+        if (!kind || incident.kind === kind) {
+            return incident;
+        }
+    }
+    return null;
+};
+
+export const countIncidents = (kind: IncidentKind): number =>
+    incidents.reduce((total, incident) => (incident.kind === kind ? total + 1 : total), 0);
+
+/** Both counts together: what the HUD's `gl` row shows. */
+export const countContextLosses = () => ({
+    lost: countIncidents('gl-lost'),
+    restored: countIncidents('gl-restored'),
+});
+
+export const subscribeToIncidents = (listener: () => void): (() => void) => {
+    listeners.add(listener);
+    return () => {
+        listeners.delete(listener);
+    };
+};
+
+export const clearIncidents = (): void => {
+    incidents = [];
+    persist();
+    publish();
+};
+
+/** Test seam: the limits are asserted rather than duplicated in the test. */
+export const INCIDENT_LIMITS = { CAPACITY, PERSISTED, STORAGE_KEY, DETAIL_MAX } as const;
diff --git a/src/services/debug/installIncidentRecorders.ts b/src/services/debug/installIncidentRecorders.ts
new file mode 100644
index 0000000..52c8ff1
--- /dev/null
+++ b/src/services/debug/installIncidentRecorders.ts
@@ -0,0 +1,125 @@
+import { readIncidents, recordIncident } from './incidents';
+import { showIncidentOverlay } from './incidentOverlay';
+
+// src/services/debug/installIncidentRecorders.ts
+// Installs the listeners that turn a black screen into a line of text.
+//
+// Called once from bootstrap, before the first render, so an exception thrown during the first
+// commit is already covered. Everything here is passive: no polling of layout, no per-frame work,
+// and the only periodic timer is the blank-root watchdog, which reads one property twice a second.
+
+/** A canvas is worth naming precisely: on this app a context loss is either a background layer or a lyric surface. */
+export const describeIncidentTarget = (target: EventTarget | null): string => {
+    if (!(target instanceof HTMLCanvasElement)) {
+        return target instanceof Element ? `${target.tagName.toLowerCase()}` : 'unknown';
+    }
+    const parent = target.parentElement;
+    const parentLabel = parent
+        ? `${parent.tagName.toLowerCase()}${parent.className ? `.${String(parent.className).split(/\s+/).slice(0, 2).join('.')}` : ''}`
+        : 'no-parent';
+    return `canvas ${target.width}x${target.height} in ${parentLabel}`;
+};
+
+const describeRejection = (reason: unknown): string => {
+    if (reason instanceof Error) {
+        return `${reason.name}: ${reason.message}`;
+    }
+    if (typeof reason === 'string') {
+        return reason;
+    }
+    try {
+        return JSON.stringify(reason) ?? String(reason);
+    } catch {
+        return String(reason);
+    }
+};
+
+/**
+ * Every way the page can fail silently: uncaught exceptions, unhandled rejections, and WebGL
+ * context loss.
+ *
+ * Context loss is recorded from the document in the capture phase because the event does not
+ * bubble, and the canvases that lose contexts are created by third-party shader plumbing that has
+ * no reason to listen. `preventDefault` is deliberately NOT called here: it promises the browser a
+ * restore, and these layers cannot rebuild their pipelines, so allowing a restore would only
+ * replace "nothing drawn" with "restored context drawing nothing". Recording it is the point.
+ */
+export const installIncidentRecorders = (): void => {
+    if (typeof window === 'undefined') {
+        return;
+    }
+
+    window.addEventListener('error', event => {
+        const errorEvent = event as ErrorEvent;
+        // Resource load failures also land here (they reach window in the capture phase). They are
+        // worth a line, but the message has to say which URL failed, not just "Script error".
+        if (errorEvent.error instanceof Error) {
+            recordIncident('error', `${errorEvent.error.name}: ${errorEvent.error.message}`);
+            return;
+        }
+        const target = event.target;
+        if (target instanceof HTMLScriptElement) {
+            recordIncident('error', `script failed to load: ${target.src}`);
+            return;
+        }
+        if (target instanceof HTMLLinkElement) {
+            recordIncident('error', `stylesheet failed to load: ${target.href}`);
+            return;
+        }
+        if (errorEvent.message) {
+            recordIncident('error', `${errorEvent.message} @ ${errorEvent.filename ?? '?'}:${errorEvent.lineno ?? 0}`);
+        }
+    }, true);
+
+    window.addEventListener('unhandledrejection', event => {
+        recordIncident('rejection', describeRejection((event as PromiseRejectionEvent).reason));
+    });
+
+    document.addEventListener('webglcontextlost', event => {
+        recordIncident('gl-lost', describeIncidentTarget(event.target));
+    }, true);
+
+    document.addEventListener('webglcontextrestored', event => {
+        recordIncident('gl-restored', describeIncidentTarget(event.target));
+    }, true);
+};
+
+/** How often the root is checked. One property read twice a second is below anything measurable. */
+const BLANK_ROOT_POLL_MS = 1200;
+
+/**
+ * Starts the black-screen detector: if the React root ends up with no children after it has once
+ * had some, nothing can be rendered by the app any more, so the plain-DOM overlay is the only thing
+ * left that can speak.
+ *
+ * Two guards keep it honest: it does not arm until the root has actually held children (a check
+ * during the first paint would fire on every boot), and it fires once per document rather than
+ * once per poll.
+ */
+export const armBlankRootWatchdog = (root: HTMLElement): (() => void) => {
+    if (typeof window === 'undefined') {
+        return () => {};
+    }
+
+    let armed = false;
+    let reported = false;
+
+    const timer = window.setInterval(() => {
+        const populated = root.childElementCount > 0;
+        if (populated) {
+            armed = true;
+            return;
+        }
+        if (!armed || reported) {
+            return;
+        }
+        reported = true;
+        recordIncident('blank-root', 'React root has no children; the tree was unmounted');
+        showIncidentOverlay({
+            title: '界面已停止渲染（黑屏）',
+            incidents: readIncidents(),
+        });
+    }, BLANK_ROOT_POLL_MS);
+
+    return () => window.clearInterval(timer);
+};
