+
+/**
+ * 游客凭证重试的最小间隔。
+ *
+ * 注册失败时如果每个请求都再试一次，一次搜索会变成两个请求，而失败本身又最可能发生在被风控盯上的时候——
+ * 正好是最不该加倍请求量的场合。参考实现把游客 token 缓存在进程里，这里用持久化的时间窗口达到同样效果，
+ * 额外的好处是刷新页面、重开应用也不会重新锤一遍。
+ */
+const ANONYMOUS_RETRY_INTERVAL_MS = 10 * 60 * 1000;
+const ANONYMOUS_RETRY_KEY = 'anonymous_retry_at';
+
+/**
+ * 没有登录态也没有游客 token 时，先换一张游客凭证。
+ *
+ * 与参考实现一样是“尽力而为”：注册失败不阻断请求，网易大部分读接口匿名也能用，
+ * 真正的拦路虎是播放地址，而那一步失败本来就有独立的降级提示。
+ */
+const ensureAnonymousSession = async (session: NeteaseSession): Promise<void> => {
+    if (session.jar.MUSIC_U || session.jar.MUSIC_A) return;
+    const lastAttempt = Number(readProviderSessionValue('netease', ANONYMOUS_RETRY_KEY) ?? 0);
+    if (Number.isFinite(lastAttempt) && Date.now() - lastAttempt < ANONYMOUS_RETRY_INTERVAL_MS) return;
+    writeProviderSessionValue('netease', ANONYMOUS_RETRY_KEY, String(Date.now()));
+
+    const route = ROUTES['/register/anonimous'];
+    try {
+        const { data, cookies } = await callNeteaseEapi(session, route.uri, route.payload(new URLSearchParams()));
+        session.jar = mergeSetCookies(session.jar, cookies);
+        session.profile = resolveNeteaseDeviceProfile();
+        if (Number(data?.code) !== 200) {
+            console.warn('NetEase anonymous session rejected', data);
+        }
+    } catch (error) {
+        console.warn('NetEase anonymous session unavailable', error);
+    }
+};
+
+/**
+ * `/playlist/track/all` 在实例里是两跳：先取歌单的 `trackIds`，再按 `limit/offset` 切一段去批量取详情。
+ * 上游不允许一次把上千首塞进 song/detail，所以这个切分不能省。
+ */
+const requestPlaylistTracks = async (session: NeteaseSession, query: URLSearchParams): Promise<any> => {
+    const detail = await callNeteaseEapi(session, '/api/v6/playlist/detail', {
+        id: query.get('id'),
+        n: 100000,
+        s: readNumber(query.get('s'), 8),
+    });
+    session.jar = mergeSetCookies(session.jar, detail.cookies);
+
+    const trackIds = Array.isArray(detail.data?.playlist?.trackIds) ? detail.data.playlist.trackIds : [];
+    const limit = readNumber(query.get('limit'), 1000);
+    const offset = readNumber(query.get('offset'), 0);
+    const slice = trackIds.slice(offset, offset + limit);
+
+    const songs = await callNeteaseEapi(session, '/api/v3/song/detail', {
+        c: `[${slice.map((item: any) => `{"id":${Number(item?.id)}}`).join(',')}]`,
+    });
+    session.jar = mergeSetCookies(session.jar, songs.cookies);
+    persistSession(session);
+
+    return songs.data;
+};
+
+/** 本地生成二维码，不联网：上游实例这一步同样只是拼链接。 */
+const createQrLoginResponse = (query: URLSearchParams) => {
+    const key = query.get('key') ?? '';
+    return {
+        code: 200,
+        data: {
+            qrurl: buildNeteaseQrLoginUrl(key),
+            qrimg: query.get('qrimg') ? renderNeteaseQrDataUrl(key) : '',
+        },
+    };
+};
+
+/**
+ * `services/netease.ts` 的本地入口：接受与真实实例完全相同的路径 + query，返回同样的 JSON。
+ *
+ * 路由之外的路径返回实例同形的 404，让现有的“这条路由不支持”降级分支照旧生效。
+ */
+export const requestLocalNetease = async (endpoint: string): Promise<any> => {
+    const [path, search = ''] = endpoint.split('?');
+    const query = new URLSearchParams(search);
+
+    if (path === '/login/qr/create') {
+        return createQrLoginResponse(query);
+    }
+
+    if (path === '/playlist/track/all') {
+        const session = loadSession();
+        await ensureAnonymousSession(session);
+        return requestPlaylistTracks(session, query);
+    }
+
+    const route = ROUTES[path];
+    if (!route) {
+        return { code: 404, msg: 'Not Found', data: null };
+    }
+
+    const session = loadSession();
+    if (route.needsAnonymous !== false) {
+        await ensureAnonymousSession(session);
+    }
+
+    const payload = route.payload(query);
+    // 组 payload 可能刚换掉 deviceId（游客注册），请求头要用新的那一个。
+    if (route.regeneratesDeviceId) {
+        session.profile = resolveNeteaseDeviceProfile();
+    }
+
+    const call = route.mode === 'weapi' ? callNeteaseWeapi : callNeteaseEapi;
+    const { data, cookies } = await call(session, route.uri, payload);
+
+    session.jar = mergeSetCookies(session.jar, cookies);
+    persistSession(session);
+
+    return route.shape ? route.shape(data, serializeCookieJar(session.jar)) : data;
+};
diff --git a/src/services/onlineMusic/neteaseQrImage.ts b/src/services/onlineMusic/neteaseQrImage.ts
new file mode 100644
index 0000000..f8e25cb
--- /dev/null
+++ b/src/services/onlineMusic/neteaseQrImage.ts
@@ -0,0 +1,38 @@
+import { renderSVG } from 'uqr';
+
+// src/services/onlineMusic/neteaseQrImage.ts
+
+/**
+ * 扫码登录的二维码是本地画出来的，不需要联网。
+ *
+ * 参考实现的 `module/login_qr_create.js` 也只是把 key 拼成链接再交给 `qrcode` 生成图片：
+ *   `https://music.163.com/login?codekey=${key}`
+ * 真正联网的只有“要 key”和“轮询状态”两步（见 `neteaseLocalApi.ts`）。
+ */
+export const NETEASE_QR_LOGIN_URL_PREFIX = 'https://music.163.com/login?codekey=';
+
+export const buildNeteaseQrLoginUrl = (key: string): string => `${NETEASE_QR_LOGIN_URL_PREFIX}${key}`;
+
+/**
+ * 把 unikey 画成 `<img src>` 能直接用的 data URL。
+ *
+ * 选 SVG 而不是 PNG：二维码是纯几何图形，SVG 在 152px 的展示尺寸上矢量清晰、体积只有几百字节，
+ * 也不用为了导出 PNG 再拉一个 canvas 依赖。`ecc: 'M'` 与官方客户端一致，留一档纠错余量，
+ * 手机在屏幕反光、倾斜角度下更好扫。border 必须留白，否则识别边界会贴着模块。
+ */
+export const renderNeteaseQrDataUrl = (key: string): string => {
+    if (!key) return '';
+    const svg = renderSVG(buildNeteaseQrLoginUrl(key), {
+        ecc: 'M',
+        border: 2,
+        pixelSize: 4,
+        whiteColor: '#FFFFFF',
+        blackColor: '#000000',
+    });
+    // btoa 要求每字符 ≤ 0xFF；renderSVG 的输出是纯 ASCII，所以直接编码即可。
+    try {
+        return `data:image/svg+xml;base64,${btoa(svg)}`;
+    } catch {
+        return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
+    }
+};
diff --git a/test/unit/onlineMusic/neteaseEapiTransport.test.ts b/test/unit/onlineMusic/neteaseEapiTransport.test.ts
new file mode 100644
index 0000000..db46154
--- /dev/null
+++ b/test/unit/onlineMusic/neteaseEapiTransport.test.ts
@@ -0,0 +1,166 @@
+import { createHash, createDecipheriv } from 'node:crypto';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import {
+    callNeteaseEapi,
+    callNeteaseWeapi,
+    type NeteaseSession,
+} from '../../../src/services/onlineMusic/neteaseEapiTransport';
+
+// test/unit/onlineMusic/neteaseEapiTransport.test.ts
+//
+// 这一层最容易“看着对、发出去全是 400”的地方是 eapi 的 payload 结构：设备头必须加密在密文里面，
+// 而且密文里那段 MD5 摘要必须能对上同一份 JSON。所以断言不是比对十六进制常量（requestId 和
+// buildver 每次不同，没法钉死），而是把密文解开、验证结构自洽：
+//   1. 第一段是请求路径；2. 第二段是 JSON 且带完整设备头与 e_r:false；3. 第三段是那串 MD5。
+// 任何一处漏掉，服务端都会以“参数错误”拒绝，而这里会在单测里先炸。
+
+const EAPI_KEY = 'e82ckenh8dichen8';
+const EAPI_SEPARATOR = '-36cd479b6b5-';
+const DEVICE_ID = 'B'.repeat(52);
+const NTES_NUID = 'a'.repeat(64);
+const PROXY_ORIGIN = 'https://appassets.androidplatform.net';
+
+const createSession = (): NeteaseSession => ({
+    profile: {
+        ntesNuid: NTES_NUID,
+        ntesNnid: `${NTES_NUID},1700000000000`,
+        wnmcid: 'abcdef.1700000000000.01.0',
+        deviceId: DEVICE_ID,
+    },
+    jar: { MUSIC_U: 'session-token', __csrf: 'csrf-token' },
+});
+
+/** 解开一整段 AES-128-ECB 密文（大写十六进制）并去掉 PKCS#7 填充。只在测试里用得到。 */
+const decryptEcb = (hex: string, key: string): string => {
+    const decipher = createDecipheriv('aes-128-ecb', Buffer.from(key, 'utf8'), null);
+    const plaintext = Buffer.concat([decipher.update(Buffer.from(hex, 'hex')), decipher.final()]);
+    return plaintext.toString('utf8');
+};
+
+/** 拦下代理请求，返回拿到的 query 参数；响应体可指定，用来喂被测的整形逻辑。 */
+const stubProxy = (envelopeBody = '{"code":200}') => {
+    const calls: URLSearchParams[] = [];
+    const fetchMock = vi.fn(async (input: any) => {
+        const url = new URL(String(input), PROXY_ORIGIN);
+        calls.push(url.searchParams);
+        return new Response(JSON.stringify({ status: 200, cookie: '', body: envelopeBody }), { status: 200 });
+    });
+    vi.stubGlobal('fetch', fetchMock);
+    return { calls, fetchMock };
+};
+
+afterEach(() => {
+    vi.unstubAllGlobals();
+});
+
+describe('callNeteaseEapi', () => {
+    it('targets the eapi host with the path minus its /api prefix', async () => {
+        const { calls } = stubProxy();
+        await callNeteaseEapi(createSession(), '/api/cloudsearch/pc', { s: 'test' });
+
+        expect(calls).toHaveLength(1);
+        expect(calls[0].get('url')).toBe('https://interfacepc.music.163.com/eapi/cloudsearch/pc');
+        expect(calls[0].get('method')).toBe('POST');
+        expect(calls[0].get('ua')).toContain('NeteaseMusic');
+    });
+
+    it('encrypts the device header inside the payload and signs the exact JSON it sent', async () => {
+        const { calls } = stubProxy();
+        await callNeteaseEapi(createSession(), '/api/cloudsearch/pc', { s: 'test' });
+
+        const params = new URLSearchParams(calls[0].get('body') ?? '').get('params') ?? '';
+        const plaintext = decryptEcb(params, EAPI_KEY);
+        const [uri, json, digest] = plaintext.split(EAPI_SEPARATOR);
+
+        expect(uri).toBe('/api/cloudsearch/pc');
+        expect(digest).toBe(createHash('md5').update(`nobody${uri}use${json}md5forencrypt`).digest('hex'));
+
+        const payload = JSON.parse(json);
+        expect(payload.s).toBe('test');
+        expect(payload.e_r).toBe(false);
+        expect(payload.header).toMatchObject({
+            deviceId: DEVICE_ID,
+            os: 'pc',
+            versioncode: '140',
+            resolution: '1920x1080',
+            __csrf: 'csrf-token',
+            MUSIC_U: 'session-token',
+        });
+        expect(payload.header.requestId).toMatch(/^\d{13}_\d{4}$/);
+        expect(payload.header.NMTID).toMatch(/^00O[0-9a-f]{38}$/);
+    });
+
+    it('sends the same device header as the Cookie header', async () => {
+        const { calls } = stubProxy();
+        await callNeteaseEapi(createSession(), '/api/cloudsearch/pc', { s: 'test' });
+
+        const cookie = calls[0].get('cookie') ?? '';
+        expect(cookie).toContain(`deviceId=${DEVICE_ID}`);
+        expect(cookie).toContain('__csrf=csrf-token');
+        expect(cookie).toContain('MUSIC_U=session-token');
+        // eapi 只发设备头，不发整份会话 cookie；后者是 weapi 的做法。
+        expect(cookie).not.toContain('_ntes_nuid');
+    });
+});
+
+describe('callNeteaseWeapi', () => {
+    it('targets the weapi host and carries a Referer, which that endpoint requires', async () => {
+        const { calls } = stubProxy();
+        await callNeteaseWeapi(createSession(), '/api/v3/song/detail', { c: '[]' });
+
+        expect(calls[0].get('url')).toBe('https://music.163.com/weapi/v3/song/detail');
+        expect(calls[0].get('referer')).toBe('https://music.163.com');
+        expect(calls[0].get('ua')).toContain('Chrome/124.0.0.0');
+    });
+
+    it('posts both encrypted halves, with encSecKey as 128 bytes of lowercase hex', async () => {
+        const { calls } = stubProxy();
+        await callNeteaseWeapi(createSession(), '/api/v3/song/detail', { c: '[]' });
+
+        const body = new URLSearchParams(calls[0].get('body') ?? '');
+        expect(body.get('params')).toBeTruthy();
+        expect(body.get('encSecKey')).toMatch(/^[0-9a-f]{256}$/);
+    });
+
+    it('sends the whole cookie jar plus the device ring, unlike eapi', async () => {
+        const { calls } = stubProxy();
+        await callNeteaseWeapi(createSession(), '/api/v3/song/detail', { c: '[]' });
+
+        const cookie = calls[0].get('cookie') ?? '';
+        expect(cookie).toContain('MUSIC_U=session-token');
+        expect(cookie).toContain(`_ntes_nuid=${NTES_NUID}`);
+        expect(cookie).toContain('WNMCID=abcdef.1700000000000.01.0');
+        expect(cookie).toContain('WEVNSM=1.0.0');
+        expect(cookie).toContain('__remember_me=true');
+    });
+});
+
+describe('failure handling', () => {
+    it('tags a transport failure as a network failure, which playback classification reads', async () => {
+        vi.stubGlobal('fetch', vi.fn(async () => {
+            throw new TypeError('Failed to fetch');
+        }));
+
+        await expect(callNeteaseEapi(createSession(), '/api/cloudsearch/pc', {})).rejects.toMatchObject({
+            networkFailure: true,
+        });
+    });
+
+    it('reports the status when the shell answers with something that is not an envelope', async () => {
+        vi.stubGlobal('fetch', vi.fn(async () => new Response('<html>nope</html>', { status: 502 })));
+
+        await expect(callNeteaseEapi(createSession(), '/api/cloudsearch/pc', {})).rejects.toMatchObject({
+            httpStatus: 502,
+        });
+    });
+
+    it('passes an upstream error envelope through instead of throwing', async () => {
+        stubProxy('{"code":502,"msg":"proxy request failed"}');
+
+        const result = await callNeteaseEapi(createSession(), '/api/cloudsearch/pc', {});
+        expect(result.status).toBe(200);
+        expect(result.data).toEqual({ code: 502, msg: 'proxy request failed' });
+    });
+});
diff --git a/test/unit/onlineMusic/neteaseLocalApi.test.ts b/test/unit/onlineMusic/neteaseLocalApi.test.ts
