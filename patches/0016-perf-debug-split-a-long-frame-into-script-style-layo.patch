diff --git a/src/services/debug/frameSamples.ts b/src/services/debug/frameSamples.ts
index 4003ef8..9696eba 100644
--- a/src/services/debug/frameSamples.ts
+++ b/src/services/debug/frameSamples.ts
@@ -43,8 +43,105 @@ export interface FrameStats {
     longestTaskMs: number;
     /** `performance.memory` is Chrome-only, so this is null where the runtime hides it. */
     heapMB: number | null;
+    /** Long animation frames seen since the last reset, and the cost split of the worst one. */
+    loafCount: number;
