+
+export interface PlacedGlyph {
+    char: string;
+    x: number;
+    y: number;
+    /** 字号（像素，已含词的倍率与整体缩放）。 */
+    size: number;
+    /** 沿行方向占的长度（像素）。 */
+    advance: number;
+    /** 行在这个字处的前进方向（弧度）。 */
+    angle: number;
+    /** 字本身的转角（竖排拉丁字母侧转 90°、弧形排随切线转）。 */
+    rotation: number;
+    /** 在字自身转角坐标系里的字框（逐字色块、包围盒用）。 */
+    boxW: number;
+    boxH: number;
+    /** 所在的行 / 列 / 词块（runs 的下标）。 */
+    row: number;
+    word: number;
+    blank: boolean;
+}
+
+export interface TextPlacement {
+    glyphs: PlacedGlyph[];
+    /** 行（横排）/ 列（竖排）/ 词块（scatter、vertical-split）：每个是一串字的下标。 */
+    rows: number[][];
+    /** 缩放后的主字号。 */
+    fontPx: number;
+    /** 为放进文字区整体缩小的倍率（≤ 1）。 */
+    fit: number;
+    /** 静止时的包围盒（含边距）。 */
+    bounds: { x: number; y: number; width: number; height: number };
