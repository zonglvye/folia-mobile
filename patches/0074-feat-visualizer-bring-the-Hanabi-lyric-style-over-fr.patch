+// Copyright (c) 2026 chthollyphile
+import type { TextLayout } from '../types';
+import { createRng } from '../hanabiRandom';
+
+// src/components/visualizer/hanabi/text/layout.ts
+// 排版（纯函数）：把逐字（字宽、所属词、词的字号倍率）按 9 种排法排进文字区，原点 = 文字区中心。
+// 超出文字区时先折行 / 换列，再整体缩小；竖排时拉丁字母侧转、中日文直立。
+
+export interface LayoutGlyphInput {
+    char: string;
+    /** 字宽（字号的倍数）。 */
+    advance: number;
+    /** 空白（空格）：不画、不占包围盒。 */
+    blank: boolean;
+    /** 竖排时直立。 */
+    upright: boolean;
+    word: number;
+}
+
+export interface LayoutWordInput {
+    /** 字区间 [start, end)。 */
+    start: number;
+    end: number;
+    /** 不是实词（标点、符号、空白）。 */
+    blank: boolean;
+    /** 全是空白。 */
+    space: boolean;
+    /** 字号倍率。 */
+    scale: number;
+}
+
+export interface LayoutParams {
+    layout: TextLayout;
+    regionWidth: number;
+    regionHeight: number;
+    /** 主字号（像素）。 */
+    fontPx: number;
+    /** 整组倾斜（弧度）。 */
+    tilt: number;
+    seed: string;
+    /** 字距（字号的倍数）。 */
+    tracking: number;
+    /** 相邻两个实词之间额外的间隔（主字号的倍数，逐词色块用）。 */
+    wordGap: number;
+    /** 行距（行内最大字号的倍数）。 */
+    lineHeight: number;
+    /** 横排时每个字至少占多宽（字号的倍数，逐字色块用）。 */
+    minAdvance: number;
+    /** 阶梯：词内逐字抬高（字号的倍数）。 */
+    stairStep: number;
