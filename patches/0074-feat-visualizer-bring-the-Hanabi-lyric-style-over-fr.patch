+    context.moveTo(c, c - r);
+    context.quadraticCurveTo(c + pinch, c - pinch, c + r, c);
+    context.quadraticCurveTo(c + pinch, c + pinch, c, c + r);
+    context.quadraticCurveTo(c - pinch, c + pinch, c - r, c);
+    context.quadraticCurveTo(c - pinch, c - pinch, c, c - r);
+    context.closePath();
+};
