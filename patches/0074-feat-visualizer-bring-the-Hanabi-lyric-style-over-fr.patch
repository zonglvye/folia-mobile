+    rigs.forEach(rig => rigOf.set(rig.index, rig));
+
+    // stamp：每个词第一个字砸下的时刻整组震动。
+    const impacts: number[] = [];
+    if (spec.enter === 'stamp') {
+        const seen = new Set<number>();
+        rigs.forEach(rig => {
+            const word = glyphs[rig.index]!.word;
