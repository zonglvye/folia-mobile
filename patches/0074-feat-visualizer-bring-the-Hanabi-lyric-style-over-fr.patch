+    sound: (text: string, color: number, size: number) => Texture;
+    /** 图标贴纸：lucide 图标（导出名，须已加载）+ 粗白边；边长 size。图标取不到时退回花。 */
+    icon: (name: string, color: number, size: number) => Texture;
+    /** 标签：圆角胶囊里一行小字。 */
+    label: (text: string, color: number, size: number) => Texture;
