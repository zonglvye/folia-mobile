+    heart: pathHeart,
+    star: (context, c, r) => pathStar(context, c, r, 5, 0.48),
+    sparkle: pathSparkle,
+    flower: pathFlower,
+    cloud: pathCloud,
+    ribbon: pathRibbon,
+    cat: pathCat,
+    bubble: pathBubble,
