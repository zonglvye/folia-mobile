+        context.moveTo(line, height / 2);
+        context.lineTo(line + dash - line, height / 2);
+        context.stroke();
+        return canvas;
+    };
+
+    /**
+     * 蕾丝花边：白色蕾丝带身，上下两排细密的小波浪边（每个波浪里镂一个小孔），带身靠边各一排孔眼，
