@@ -0,0 +1,37 @@
+import type { SongResult } from '../../../types';
+import type { MediaId, OnlineMutationProvider, ProviderCollection } from '../../../types/onlineMusic';
+import { OnlineProviderError } from '../../../types/onlineMusic';
+import { getPlaybackSourceRef } from '../../../utils/appPlaybackGuards';
+import { requestQishui } from './qishuiTransport';
+
+// Account writes use Omni's source identity and only expose editing for ordinary owned playlists.
+export function qishuiSongId(song: MediaId | SongResult): string {
+    if (typeof song !== 'object') return String(song);
+    const source = getPlaybackSourceRef(song);
+    if (source.kind !== 'online' || source.providerId !== 'qishui') {
+        throw new OnlineProviderError('unsupported', 'Song does not belong to Qishui', 'qishui');
+    }
+    return source.mediaId;
+}
+const editable = (playlist: ProviderCollection) => playlist.providerId === 'qishui'
+    && playlist.type === 'playlist' && playlist.isOwned === true && playlist.isLiked !== true;
+
+export const qishuiMutations: OnlineMutationProvider = {
+    canAddToPlaylist: editable,
+    canEditPlaylistTracks: editable,
+    async likeSong(song, liked) {
+        await requestQishui('like_song', { id: qishuiSongId(song), liked });
+        console.info('[Qishui] Song like changed', { liked });
+    },
+    async updatePlaylistTracks(operation, playlist, tracks) {
+        if (typeof playlist !== 'object' || !editable(playlist)) {
+            throw new OnlineProviderError('unsupported', 'Playlist is not an owned Qishui playlist', 'qishui');
+        }
+        if (!tracks.length) return;
+        if (tracks.length > 100) throw new OnlineProviderError('unsupported', 'Select at most 100 tracks per operation', 'qishui');
+        await requestQishui(operation === 'add' ? 'playlist_add_tracks' : 'playlist_remove_tracks', {
+            id: String(playlist.id), ids: tracks.map(qishuiSongId),
+        });
+        console.info('[Qishui] Playlist tracks changed', { operation, count: tracks.length });
+    },
+};
diff --git a/src/services/onlineMusic/qishui/qishuiNormalize.ts b/src/services/onlineMusic/qishui/qishuiNormalize.ts
new file mode 100644
index 0000000..d0fb36a
--- /dev/null
+++ b/src/services/onlineMusic/qishui/qishuiNormalize.ts
@@ -0,0 +1,53 @@
+import type { UnifiedSong } from '../../../types';
+import type { ProviderCollection, ProviderUser } from '../../../types/onlineMusic';
+import { OnlineProviderError } from '../../../types/onlineMusic';
+
+// Normalize car entities without rounding 64-bit media IDs or guessing playability from payment labels.
+export type QishuiRecord = Record<string, any>;
+export const record = (raw: unknown): QishuiRecord => raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
+const text = (value: unknown) => value == null ? '' : String(value);
+export function qishuiImage(raw: unknown): string {
+    if (typeof raw === 'string') return raw.startsWith('https://') ? raw : '';
+    const value = record(raw);
+    const url = Array.isArray(value.urls) ? value.urls.find((item: unknown) => typeof item === 'string' && item.startsWith('https://')) : '';
+    if (!url) return '';
+    return value.uri && url.endsWith('/') ? `${url}${value.uri}${value.template_prefix ? `~${value.template_prefix}-image.image` : ''}` : url;
+}
+export function normalizeQishuiSong(raw: unknown): UnifiedSong {
+    const song = record(raw);
+    if (song.sourceRef?.kind === 'online' && song.sourceRef.providerId === 'qishui') return song as UnifiedSong;
+    const base = record(song.base_info);
+    const id = text(base.id || song.id);
+    if (!/^\d+$/.test(id)) throw new OnlineProviderError('invalid-response', 'Qishui track ID is missing', 'qishui');
+    const related = record(song.related_info);
+    const album = record(related.album_link);
+    const artists = Array.isArray(related.artist_links) ? related.artist_links : base.song_maker_team?.composers || [];
+    return {
+        id, name: text(base.name), durationMs: Math.max(0, Number(base.duration_ms) || 0),
+        artists: artists.filter((artist: QishuiRecord) => artist.name).map((artist: QishuiRecord) => ({
+            id: text(artist.id), name: text(artist.name), ...(artist.id ? { catalogRef: { providerId: 'qishui', kind: 'artist' as const, id: text(artist.id) } } : {}),
+        })),
+        // The car SDK has no album endpoint; retain metadata without an unusable album link.
+        album: { id: text(album.id), name: text(album.name), coverUrl: qishuiImage(song.display_info?.cover_url) },
+        sourceRef: { kind: 'online', providerId: 'qishui', mediaId: id },
+    };
+}
+export function normalizeQishuiCollection(raw: unknown, type = 'playlist'): ProviderCollection {
+    const item = record(raw);
+    if (item.providerId === 'qishui') return item as ProviderCollection;
+    const base = record(item.base_info);
+    if (!base.id) throw new OnlineProviderError('invalid-response', 'Qishui collection ID is missing', 'qishui');
+    const owner = record(item.relation_info?.owner);
+    return { providerId: 'qishui', id: text(base.id), type, name: text(base.title || base.name),
+        coverUrl: qishuiImage(type === 'artist' ? base.url_avatar : item.display_info?.url_cover), description: text(base.desc || base.intro),
+        ...(item.resource_cnt?.track_cnt == null ? {} : { trackCount: Number(item.resource_cnt.track_cnt) }),
+        ...(owner.id ? { creator: { id: text(owner.id), nickname: text(owner.nickname) } } : {}),
+        ...(item.isOwned == null ? {} : { isOwned: Boolean(item.isOwned) }), providerData: { ownerId: text(base.owner_id || owner.id) },
+        ...(Number(base.type) === 1 && item.isOwned === true ? { isLiked: true } : {}),
+    };
+}
+export function normalizeQishuiUser(raw: unknown): ProviderUser {
+    const user = record(raw);
+    if (!user.id) throw new OnlineProviderError('invalid-response', 'Qishui account ID is missing', 'qishui');
+    return { id: text(user.id), nickname: text(user.nickname), avatarUrl: qishuiImage(user.avatar), vipType: user.isVip ? 1 : 0 };
+}
diff --git a/src/services/onlineMusic/qishui/qishuiPlayback.ts b/src/services/onlineMusic/qishui/qishuiPlayback.ts
new file mode 100644
index 0000000..58e690b
--- /dev/null
+++ b/src/services/onlineMusic/qishui/qishuiPlayback.ts
@@ -0,0 +1,54 @@
+import type { QishuiTrackCheck } from 'qishui-music-api';
+import type { OnlinePlaybackProvider, ProviderAudioSource, ProviderSongAvailability } from '../../../types/onlineMusic';
+import { normalizeQishuiSong } from './qishuiNormalize';
+import { qishuiSongId } from './qishuiMutations';
+import { QishuiRequestError, requestQishui } from './qishuiTransport';
+
+// Qishui's playback side: one song's detail by id, its plaintext audio address, and its playability checks.
+// Explicit playability checks are short-lived account facts; playback failures never change them.
+const checks = new Map<string, { at: number; availability: ProviderSongAvailability }>();
+let revision = 0;
+export function clearQishuiPlayback() { revision++; checks.clear(); }
+export async function readQishuiSongs(raw: unknown[]) {
+    const songs = raw.map(normalizeQishuiSong);
+    if (!songs.length) return songs;
+    const mine = revision;
+    try {
+        const data = await requestQishui<{ statuses: QishuiTrackCheck[] }>('check_tracks', { ids: songs.map(song => String(song.id)) });
+        if (mine !== revision) return songs;
+        const wanted = new Set(songs.map(song => String(song.id)));
+        for (const row of data.statuses) {
+            if (!wanted.has(row.id) || !Number.isInteger(row.riskResult) || row.riskResult < 0) continue;
+            checks.delete(row.id);
+            checks.set(row.id, { at: Date.now(), availability: row.riskResult === 0
+                ? { state: 'playable' } : { state: 'unknown', reason: 'restricted' } });
+        }
+        while (checks.size > 500) checks.delete(checks.keys().next().value!);
+    } catch (error) {
+        // A failed optional check must not hide otherwise readable songs or imply a takedown.
+        console.warn('[Qishui] Track availability check failed', error);
+    }
+    return songs;
+}
+// The package's sentence when the service answered a look-up without the track (qishui-music-api@0.2.1,
+// src/catalog.cjs `track`). For song_detail it is the only not-playable there is: the other failures of
+// that operation are network, auth-required, unavailable or invalid-response.
+const TRACK_NOT_RETURNED = 'Qishui did not return the track';
+export const qishuiPlayback: OnlinePlaybackProvider = {
+    audioQualityLevels: ['standard'],
+    async getSongDetail(id) {
+        let raw: unknown;
+        try { raw = await requestQishui('song_detail', { id: String(id) }); }
+        catch (error) {
+            // Qishui answered and has no such track: the song is missing, the request did not fail.
+            if (error instanceof QishuiRequestError && error.code === 'not-playable' && error.message === TRACK_NOT_RETURNED) return null;
+            throw error;
+        }
+        return (await readQishuiSongs([raw]))[0];
+    },
+    getAudioSource: (song, quality) => requestQishui<ProviderAudioSource>('audio', { id: qishuiSongId(song), quality }),
+    getAvailability(song) {
+        const check = checks.get(qishuiSongId(song));
+        return check && Date.now() - check.at < 60_000 ? check.availability : { state: 'unknown' };
+    },
+};
diff --git a/src/services/onlineMusic/qishui/qishuiProvider.ts b/src/services/onlineMusic/qishui/qishuiProvider.ts
new file mode 100644
index 0000000..f07aa46
--- /dev/null
+++ b/src/services/onlineMusic/qishui/qishuiProvider.ts
@@ -0,0 +1,60 @@
+import type { OnlineMusicProvider, ProviderPage, QrLoginState } from '../../../types/onlineMusic';
+import { OnlineProviderError } from '../../../types/onlineMusic';
+import { createProviderSongMetadata } from '../../../utils/songMetadata';
+import { getQishuiLastFailure, getQishuiAvailability, requestQishui } from './qishuiTransport';
+import { normalizeQishuiSong, normalizeQishuiUser, normalizeQishuiCollection } from './qishuiNormalize';
+import { qishuiCatalog, qishuiLibrary } from './qishuiCatalog';
+import { parseQishuiLyrics } from './qishuiLyrics';
+import { qishuiRecommendations, clearQishuiRecommendations } from './qishuiRecommendations';
+import { qishuiMutations, qishuiSongId as songId } from './qishuiMutations';
+import { qishuiPlayback, clearQishuiPlayback, readQishuiSongs } from './qishuiPlayback';
+
+// Car platform adapter; account and catalogue operations share the existing Omni entry points.
+// 换账号时要一起丢掉的：场景目录、可播放性检查，以及推荐流的记忆。
+// （上游还多一个「探索流」，那条流水线在我们这条分支上不存在，见文件头的裁剪说明。）
+function clearAccountState() { clearQishuiRecommendations(); clearQishuiPlayback(); }
+export const qishuiProvider: OnlineMusicProvider = {
+    id: 'qishui', displayName: '汽水音乐', shortName: '汽水',
+    getAvailability: getQishuiAvailability,
+    capabilities: { search: true, playback: true, lyrics: true, wordByWordLyrics: true, auth: true,
+        userLibrary: true, playlists: true, albums: false, artists: true, recommendations: true,
+        mutations: true, likes: true, playlistTrackMutations: true, personalFmModes: true },
+    normalizeSong: normalizeQishuiSong, normalizeUser: normalizeQishuiUser, normalizeCollection: normalizeQishuiCollection,
+    songMetadata: { getSongMetadata: createProviderSongMetadata },
+    getSongPageUrl: song => `https://music.douyin.com/qishui/share/track?track_id=${encodeURIComponent(songId(song))}`,
+    search: {
+        async searchSongs(query, limit, offset) {
+            if (!query.trim()) return { items: [], hasMore: false, nextOffset: offset };
+            const page = await requestQishui<ProviderPage<unknown>>('search', { query, limit, offset });
+            return { ...page, items: await readQishuiSongs(page.items) };
+        },
+    },
+    playback: qishuiPlayback,
+    lyrics: { getLyrics: async song => parseQishuiLyrics(await requestQishui('lyrics', { id: songId(song) })) },
+    auth: {
+        async getQrLoginDiagnostics() {
+            const failure = getQishuiLastFailure();
+            if (!failure) return [];
+            return [`stage=${failure.stage ?? '-'} code=${failure.code} upstreamCode=${failure.upstreamCode ?? '-'}`];
+        },
+        async getLoginStatus() { const user = await requestQishui('login_status'); return user ? normalizeQishuiUser(user) : null; },
+        async getQrKey() { return (await requestQishui<{ key: string }>('login_qr_key')).key; },
+        async createQr(key) { return (await requestQishui<{ imageUrl: string }>('login_qr_create', { key })).imageUrl; },
+        async checkQr(key) {
+            try {
+                const result = await requestQishui<QrLoginState>('login_qr_check', { key });
+                if (result.state === 'confirmed') clearAccountState();
+                return result;
+            } catch (error) {
+                if (error instanceof OnlineProviderError && error.code === 'network') return { state: 'error', transient: true, failure: { case: 'unreachable' } } as QrLoginState;
+                throw error;
+            }
+        },
+        async cancelQr(key) { await requestQishui('login_qr_cancel', { key }); },
+        getQrTtlMs: () => 300000,
+        async logout() { clearAccountState(); await requestQishui('logout'); },
+    },
+    catalog: qishuiCatalog, library: qishuiLibrary,
+    recommendations: qishuiRecommendations,
+    mutations: qishuiMutations,
+};
