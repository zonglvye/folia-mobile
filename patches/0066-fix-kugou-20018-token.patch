 src/services/onlineMusic/kugouProvider.ts | 12 ++++++++----
 src/services/onlineMusic/kugouWebAuth.ts  | 18 ++++++++++++++----
 2 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/src/services/onlineMusic/kugouProvider.ts b/src/services/onlineMusic/kugouProvider.ts
index 4259eac..be33978 100644
--- a/src/services/onlineMusic/kugouProvider.ts
+++ b/src/services/onlineMusic/kugouProvider.ts
@@ -1370,10 +1370,14 @@ export const kugouProvider: OnlineMusicProvider = {
             if (getKugouTransportMode() !== ANONYMOUS_PUBLIC_MODE) {
                 throw new OnlineProviderError('unsupported', 'KuGou phone login is only used without a backend', 'kugou');
             }
-            await loginKugouWithCode(mobile, code);
-            const user = await fetchKugouWebUser();
-            if (!user) throw new OnlineProviderError('invalid-response', 'KuGou login returned no profile', 'kugou');
-            return user;
+            const session = await loginKugouWithCode(mobile, code);
+            // 登录已经成功、token 已经落盘：资料这一步失败不该把登录判成失败（否则用户会以为没登进去，
+            // token 却留在存储里）。先给一个只带 id 的占位用户，账户刷新会补上昵称头像。
+            const user = await fetchKugouWebUser().catch(error => {
+                console.warn('[KugouProvider] profile after login failed', error);
+                return null;
+            });
+            return user ?? { id: session.userid, nickname: '酷狗', avatarUrl: '' };
         },
         async getQrKey() {
             const response = await requestKugou('login_qr_key');
