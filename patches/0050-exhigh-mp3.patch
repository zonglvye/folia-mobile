+            const requested = query.get('level') || 'exhigh';
+            const level = requested === 'lossless' || requested === 'hires' ? 'exhigh' : requested;
+            return {
+                ids: `[${query.get('id')}]`,
+                level,
+                // 上游这个接口**必须**带 encodeType（不带就 400 参数错误）；显式要 mp3，
+                // 免得以后有人把 level 放开到无损时又悄悄变成几十 MB 的 flac。
+                encodeType: 'mp3',
+            };
+        },
