 src/i18n/locales/in.ts              |  1 +
 src/i18n/locales/zh-CN.ts           |  1 +
 src/services/onlineMusic/omni.ts    | 19 +++++++++++++++++++
 src/utils/playerLikeAvailability.ts |  4 +++-
 5 files changed, 25 insertions(+), 1 deletion(-)

