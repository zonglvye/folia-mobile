diff --git a/src/services/onlineMusic/omni.ts b/src/services/onlineMusic/omni.ts
index 0c1bc72..84ab033 100644
--- a/src/services/onlineMusic/omni.ts
+++ b/src/services/onlineMusic/omni.ts
@@ -392,11 +392,29 @@ export const omni = {
         const source = getPlaybackSourceRef(song);
         if (source.kind !== 'online') return false;
         const provider = getOnlineMusicProvider(source.providerId);
+        if (!this.allowsAccountMutation(provider, source.providerId)) return false;
         return providerSupports(provider, 'mutations')
             && providerSupports(provider, 'likes')
             && Boolean(provider?.mutations?.likeSong);
     },
 
+    /**
+     * 账号相关的写入（收藏 / 不喜欢）现在能不能做。游客可用的平台（汽水）能播不能收藏：
+     * 没登录就别让按钮点亮，点了只会拿到 auth-required。其它平台维持原样（它们本来就没有游客态）。
+     */
+    allowsAccountMutation(
+        provider: OnlineMusicProvider | null,
+        providerId: OmniProviderId,
+    ): boolean {
+        if (!provider?.capabilities.guestAccess) return true;
+        return useOnlineProviderAccountStore.getState().accounts[providerId]?.status === 'authenticated';
+    },
+
+    /** 上面那条为 false 时的另一种说法：不是「不支持」，是「登录后才能用」（给文案挑 key 用）。 */
+    needsSignInForAccountMutation(providerId: OmniProviderId): boolean {
+        return !this.allowsAccountMutation(getOnlineMusicProvider(providerId), providerId);
+    },
+
     canEditCollectionTracks(collection: OmniCollection): boolean {
         const provider = getOnlineMusicProvider(collection.providerId);
         if (!providerSupports(provider, 'mutations')) return false;
@@ -412,6 +430,7 @@ export const omni = {
         const source = getPlaybackSourceRef(song);
         if (source.kind !== 'online') return false;
         const provider = getOnlineMusicProvider(source.providerId);
+        if (!this.allowsAccountMutation(provider, source.providerId)) return false;
         return providerSupports(provider, 'recommendations')
             && Boolean(provider?.recommendations?.dislikeSong);
     },
diff --git a/src/utils/playerLikeAvailability.ts b/src/utils/playerLikeAvailability.ts
index 5b06d22..50b2274 100644
--- a/src/utils/playerLikeAvailability.ts
+++ b/src/utils/playerLikeAvailability.ts
@@ -32,10 +32,12 @@ export const resolveLikeAvailability = (
 
     const sourceRef = getPlaybackSourceRef(currentSong);
     if (sourceRef.kind === 'online' && !omni.canLikeSong(currentSong)) {
+        // 平台支持收藏、只是还没登录（汽水游客）：说的不是「不支持」，而是「登录后可以」。
+        const needsSignIn = omni.needsSignInForAccountMutation(sourceRef.providerId);
         return {
             disabled: true,
             reason: {
-                key: 'status.providerLikeUnavailable',
+                key: needsSignIn ? 'status.providerLikeNeedsSignIn' : 'status.providerLikeUnavailable',
                 params: { provider: omni.getProviderLabel(sourceRef.providerId) },
             },
         };
