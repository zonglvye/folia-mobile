+++ b/src/utils/platform.ts
@@ -22,3 +22,13 @@ export const isSecondaryModifierPressed = (event: KeyboardEvent): boolean => (
 
 /** Label for the primary modifier, for shortcut hints shown in the UI. */
 export const PRIMARY_MODIFIER_LABEL = isMacPlatform ? 'Cmd' : 'Ctrl';
+
+/**
+ * Whether this build is running inside the Android shell that bundles the web app into the APK.
+ * The shell injects `window.foliaAndroid` (see services/deviceAudioLibrary.ts); a browser and the
+ * Electron main window both lack it. Detected by presence rather than user agent, so a phone
+ * browser visiting the same build is not mistaken for the packaged app.
+ */
+export const isAndroidShell = (): boolean => (
+    typeof window !== 'undefined' && Boolean((window as { foliaAndroid?: unknown }).foliaAndroid)
+);
diff --git a/test/unit/utils/frameRateLimiter.test.ts b/test/unit/utils/frameRateLimiter.test.ts
index 8e01c37..2ea229e 100644
--- a/test/unit/utils/frameRateLimiter.test.ts
+++ b/test/unit/utils/frameRateLimiter.test.ts
@@ -1,5 +1,5 @@
 import { describe, expect, it } from 'vitest';
-import { createFrameRateLimitedRaf, installGlobalVisualizerFrameRateLimiter, parseVisualizerFrameRate, setGlobalVisualizerFrameRate, shouldProcessFrameAtRate } from '../../../src/utils/frameRateLimiter';
+import { createFrameRateLimitedRaf, ensureVisualizerFrameRateDefault, installGlobalVisualizerFrameRateLimiter, parseVisualizerFrameRate, setGlobalVisualizerFrameRate, shouldProcessFrameAtRate, VISUALIZER_FRAME_RATE_STORAGE_KEY } from '../../../src/utils/frameRateLimiter';
 
 // test/unit/utils/frameRateLimiter.test.ts
 
@@ -172,4 +172,60 @@ describe('frameRateLimiter', () => {
             });
         }
     });
+
+    it('seeds the mobile default only when no frame rate was ever chosen', () => {
+        const previousWindow = (globalThis as { window?: Window; }).window;
+        const store = new Map<string, string>();
+        Object.defineProperty(globalThis, 'window', {
+            configurable: true,
+            value: {
+                requestAnimationFrame: () => 1,
+                cancelAnimationFrame: () => undefined,
+                localStorage: {
+                    getItem: (key: string) => store.get(key) ?? null,
+                    setItem: (key: string, value: string) => { store.set(key, value); },
+                },
+            },
+        });
+
+        try {
+            ensureVisualizerFrameRateDefault(60);
+            expect(store.get(VISUALIZER_FRAME_RATE_STORAGE_KEY)).toBe('60');
+
+            // An explicit choice is respected even when it is the "off" value, which is why the
+            // guard tests for presence instead of truthiness.
+            store.set(VISUALIZER_FRAME_RATE_STORAGE_KEY, 'off');
+            ensureVisualizerFrameRateDefault(60);
+            expect(store.get(VISUALIZER_FRAME_RATE_STORAGE_KEY)).toBe('off');
+        } finally {
+            Object.defineProperty(globalThis, 'window', {
+                configurable: true,
+                value: previousWindow,
+            });
+        }
+    });
+
+    it('survives a storage that refuses to read or write', () => {
+        const previousWindow = (globalThis as { window?: Window; }).window;
+        Object.defineProperty(globalThis, 'window', {
+            configurable: true,
+            value: {
+                requestAnimationFrame: () => 1,
+                cancelAnimationFrame: () => undefined,
+                localStorage: {
+                    getItem: () => { throw new Error('denied'); },
+                    setItem: () => { throw new Error('denied'); },
+                },
+            },
+        });
+
+        try {
+            expect(() => ensureVisualizerFrameRateDefault(60)).not.toThrow();
+        } finally {
+            Object.defineProperty(globalThis, 'window', {
+                configurable: true,
+                value: previousWindow,
+            });
+        }
+    });
 });
