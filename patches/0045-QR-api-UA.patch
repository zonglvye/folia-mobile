     '/login/qr/check': {
-        mode: 'eapi',
+        mode: 'api',
         uri: '/api/login/qrcode/client/login',
         payload: query => ({ key: query.get('key'), type: 3 }),
         shape: (data, cookie) => ({ ...data, cookie }),
@@ -470,7 +477,9 @@ export const requestLocalNetease = async (endpoint: string): Promise<any> => {
