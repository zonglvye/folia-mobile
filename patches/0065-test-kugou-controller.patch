 src/services/onlineMusic/kugouWebAuth.ts      |  7 +-
 .../core/providerAccountController.test.ts    | 82 +++++++++++++++++++
 3 files changed, 98 insertions(+), 9 deletions(-)

diff --git a/src/library/core/services/providerAccountController.ts b/src/library/core/services/providerAccountController.ts
index c5ef9c8..b06bf37 100644
--- a/src/library/core/services/providerAccountController.ts
+++ b/src/library/core/services/providerAccountController.ts
@@ -480,13 +480,17 @@ export const createProviderAccountController = (deps: LibraryAccountControllerDe
             });
             return { status: 'ok' };
         }
-        const result = await openSwitchRequest(current.providerId, 'activate-after-login');
-        batch(() => {
-            lastLoginCompletion = {
-                sessionId: completionId,
-                providerId: current.providerId,
-                outcome: result.status === 'switched' ? 'completed' : 'activation-declined',
-            };
+        // 发起激活确认但不在这里等用户答复：确认框是 UI 的事，登录动作不能挂着它。
+        // 结局照样写进 lastLoginCompletion，与扫码登录的收尾一致。
+        void openSwitchRequest(current.providerId, 'activate-after-login').then(result => {
+            if (disposed) return;
+            batch(() => {
+                lastLoginCompletion = {
+                    sessionId: completionId,
+                    providerId: current.providerId,
+                    outcome: result.status === 'switched' ? 'completed' : 'activation-declined',
+                };
+            });
         });
         return { status: 'ok' };
     };
