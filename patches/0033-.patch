+/* 窄视口（手机横屏）的底部面板。判定只认 JS 加上的 `.is-sheet`（BravaisSeamMenuSheet 按 isNarrowViewport 决定，
+   阈值只有 BRAVAIS_NARROW_VIEWPORT_PX 一处）——这里不用媒体查询：`max-width: 900px` 会在正好 900px 上命中，
+   而 JS 那一档是 `width < 900`，两边错开一次就会把没挂 portal 的菜单固定到带变换的缝里、飞出屏幕。
+   缝在这一档只有 300px 宽，从缝里弹出的菜单会往墙上伸出两百多像素，正好压住墙中央那张封面
+   （用户实测：「点进歌单后封面被黑菜单盖住，显示不全」）。 */
+.bravais-seam-menu.is-sheet {
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: calc(10px + env(safe-area-inset-bottom, 0px));
+    top: auto;
+    z-index: 61;
+    width: min(440px, calc(100vw - 24px));
+    max-height: 62vh;
+    margin-inline: auto;
+    padding: 8px;
+    gap: 0;
+    overflow-y: auto;
+    border-radius: 16px;
+    /* 面板自己带不透明底与阴影：手机上面板离内容更近，半透明会让下面的封面透上来。 */
+    background: color-mix(in srgb, var(--bg-color, #070707) 96%, var(--text-primary, #f7f4ee));
+    box-shadow: 0 0 0 1px color-mix(in srgb, currentColor 14%, transparent), 0 -8px 32px rgb(0 0 0 / 44%);
+}
+
+/* 行高收紧：手机横屏视口只有 377px 高，六项菜单要一次放得下。 */
+.bravais-seam-menu.is-sheet button {
+    padding: 7px 10px;
+}
+
+.bravais-seam-menu.is-sheet > .bravais-seam-menu-rule {
+    margin: 4px 6px;
+}
+
+/* 遮罩：把墙压暗，点它收起（缝自己的「点别处收起」监听会收到这一下）。只在底部面板那一档渲染。 */
+.bravais-seam-menu-scrim {
+    position: fixed;
+    inset: 0;
+    z-index: 60;
+    background: rgb(0 0 0 / 42%);
+}
+
 /* ---------- 表单态 ---------- */
 
 .bravais-seam-form {
