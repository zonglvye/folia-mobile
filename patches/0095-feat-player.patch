+
+/* 横屏矮视口（< 420px 高）：控制中心要一屏看全，内容间距压一档。
+   只影响矮屏，桌面与竖屏不动。 */
+@media (max-height: 420px) {
+    .player-panel-scroll .space-y-4 > * + * {
+        margin-top: 0.5rem;
+    }
+
+    .player-panel-scroll .space-y-3 > * + * {
+        margin-top: 0.4rem;
+    }
+
