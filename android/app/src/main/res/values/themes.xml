<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material theme on purpose: the shell has no AppCompat dependency, and the
         web app draws every pixel itself. The theme only needs to avoid a white flash. -->
    <style name="Theme.Folia" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
