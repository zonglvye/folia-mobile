<?xml version="1.0" encoding="utf-8"?>
<!--
  Folia Mobile shell manifest.

  Deliberate differences from the third-party shell this design was informed by:
  - No global cleartext traffic: `usesCleartextTraffic` stays false. The other shell enabled it
    globally through network_security_config just to make one CDN work; that is too broad a
    concession, so the two source hosts that genuinely need it are allowlisted by name in
    res/xml/network_security_config.xml instead.
  - No REQUEST_INSTALL_PACKAGES: the shell ships no self-update channel.
  - Landscape is the product decision ("观赏播放器"), so the activity declares it. The system
    rotation lock can still override it, which is why MainActivity keeps a portrait fallback.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Device music library: reading the user's own audio collection through MediaStore. Android 13
         split the old storage permission into per-type ones, so the modern permission is declared
         plainly and the legacy one is capped at API 32 - asking for READ_EXTERNAL_STORAGE on 33+
         is granted but silently ignored, which would look like "the dialog was accepted and nothing
         happened". Nothing here is written back: the shell only ever reads this collection. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Background playback: the media notification and lock-screen transport need a
         foreground service. Android 14+ requires the mediaPlayback subtype to be declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ gates the media notification (and therefore the lock-screen card) behind
         this runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Folia"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="userLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
